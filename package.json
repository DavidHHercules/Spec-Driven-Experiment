{
  "name": "weather-summary-func",
  "version": "0.1.0",
  "private": true,
  "description": "Azure Function App wrapping Open-Meteo. Spec-driven development practice project.",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prestart": "npm run build",
    "start": "func start",
    "azurite": "azurite --silent --location .azurite --skipApiVersionCheck",
    "package": "npm run build && node scripts/package.js",
    "package:check": "npm run build && node scripts/package.js --check"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.17.0",
    "@azure/identity": "^4.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "azurite": "^3.37.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
